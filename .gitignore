# macOS metadata
.DS_Store

# Lokale Rokade-exporten kunnen persoonsgegevens en databasebestanden bevatten.
# Plaats ze lokaal in deze map voor Docker; ze worden nooit gecommit. Elke
# submap kan een eigen bron zijn, bijvoorbeeld docs/current/senioren.
/docs/current/*

# Lokaal gegenereerde WordPress-pluginpakketten.
/dist/

# Lokale inloggegevens voor het handleidingscenario.
/tools/handleiding/.env
/tools/handleiding/node_modules/

# Opname-uitvoer van het handleidingsscenario. Bouw deze lokaal met de scripts
# in tools/handleiding; bron, scripts en handleidingstekst blijven wel in Git.
/docs/handleiding/Handleiding-Rokade-Standen.pdf
/docs/handleiding/media/
