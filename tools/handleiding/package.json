{
  "name": "rokade-standings-handleiding",
  "private": true,
  "type": "module",
  "description": "Neemt het handleidingscenario op: schermafbeeldingen en video van instellen en gebruiken.",
  "scripts": {
    "capture": "node capture.mjs",
    "capture:instellen": "node capture.mjs --only=instellen",
    "capture:gebruiken": "node capture.mjs --only=gebruiken",
    "seed": "node capture.mjs --seed-only",
    "pdf": "node pdf.mjs",
    "handleiding": "npm run capture && npm run pdf",
    "controleer": "node controleer.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "dependencies": {
    "marked": "^18.0.13"
  }
}
