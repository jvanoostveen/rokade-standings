# Kopieer naar .env (die staat in .gitignore) en vul het wachtwoord in.
WP_BASE_URL=http://localhost:8080
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
# Nederlandse admin, zodat de beelden bij de Nederlandse tekst passen.
WP_LOCALE=nl_NL
# 1 = normaal tempo; 1.5 is rustiger, 0.6 sneller (handig bij het bijwerken).
CAPTURE_PACE=1
